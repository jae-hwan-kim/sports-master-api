PORT=3000
NODE_ENV=local
SENTRY_DSN=

# Auth / JWT (필수 — 미설정 시 서버 부팅 실패)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# 관리자 API (임시: role 모델 도입 전까지 헤더 X-Admin-Key 대조용, 필수)
ADMIN_API_KEY=

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
# 콘솔의 "카카오 로그인" 클라이언트 시크릿 활성화 시 필수(비활성화면 비워둬도 됨)
KAKAO_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# File upload
UPLOAD_DIR=uploads
