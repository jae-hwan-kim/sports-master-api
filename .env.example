PORT=3000
NODE_ENV=local
SENTRY_DSN=

# Auth / JWT (필수 — 미설정 시 서버 부팅 실패)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# 관리자 API (임시: role 모델 도입 전까지 헤더 X-Admin-Key 대조용, 필수)
ADMIN_API_KEY=

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
# 콘솔의 "카카오 로그인" 클라이언트 시크릿 활성화 시 필수(비활성화면 비워둬도 됨)
KAKAO_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=

# Google OAuth — 값이 비어있으면 idToken 검증 시 audience 체크가 사실상 스킵되어
# (google-auth-library가 undefined를 "검증 안 함"으로 처리) 보안상 반드시 채워야 함.
# GOOGLE_CLIENT_ID: iOS 유형 클라이언트 ID(iOS idToken의 aud)
# GOOGLE_WEB_CLIENT_ID: Web 유형 클라이언트 ID(Android 네이티브 SDK idToken의 aud)
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# File upload
UPLOAD_DIR=uploads
